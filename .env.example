# Producette — variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# Nunca subas .env.local al repositorio.

# ── App ───────────────────────────────────────────────────────────────────────
# URL base del entorno (sin barra final)
# local: http://localhost:3000  |  staging: https://staging.producette.com  |  prod: https://producette.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Entorno: local | staging | production
# En Vercel se detecta vía VERCEL_TARGET_ENV; en local ponlo siempre en "local".
NEXT_PUBLIC_APP_ENV=local

# ── Supabase: producette-dev (ref: aeypdriubewywzngjzgf) ─────────────────────
# Obtén los valores en: https://supabase.com/dashboard/project/aeypdriubewywzngjzgf/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://aeypdriubewywzngjzgf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Settings → API → JWT Settings → JWKS URL
SUPABASE_JWKS_URL=

# ── Base de datos: pooler en modo transacción (puerto 6543) ───────────────────
# Dashboard → Project Settings → Database → Connection string → Transaction
DATABASE_URL=

# ── Stripe: sandbox dev ───────────────────────────────────────────────────────
# Dashboard → Developers → API keys (en modo Test / sandbox dev)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Claves de firma de webhooks (Paso 5):
#   npm run stripe:listen      → muestra las claves al arrancar
#   stripe listen --print-secret
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_V2_WEBHOOK_SECRET=

# ── Internos ──────────────────────────────────────────────────────────────────
# Secreto para las llamadas de pg_cron a /api/internal/*
# Genera: node -p "require('crypto').randomBytes(32).toString('hex')"
CRON_SECRET=

# Contraseña compartida de staging (Paso 9). No existe en producción ni en local.
STAGING_PASSWORD=

# ── Datos de prueba (npm run seed, npm run test:rls) ──────────────────────────
# Correo base: los usuarios se crean como alias (tu+cliente1@…, tu+host1@…).
SEED_EMAIL=
# Correo de Patricia, que queda como Admin en panel_users.
SEED_ADMIN_EMAIL=
# Contraseña conocida compartida por los usuarios de prueba.
SEED_PASSWORD=

# ── Plazos (Paso 6) ───────────────────────────────────────────────────────────
# Multiplica los plazos en horas fuera de producción.
# Ejemplo: 0.0035 ≈ 10 minutos por cada 48 horas de plazo.
# En producción debe ser 1 (o no estar definida).
DEADLINE_SCALE=1

# ── Emails: Resend (Paso 8) ───────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@producette.com

# Destinatarios permitidos fuera de producción (separados por coma)
EMAIL_ALLOWLIST=

# ── Errores: Sentry (Paso 8) ──────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Mapa: Mapbox (Paso 8) ─────────────────────────────────────────────────────
# Token restringido por URL de origen
NEXT_PUBLIC_MAPBOX_TOKEN=
