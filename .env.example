# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# Publishable (anon) key (Settings > API > Project API keys > anon public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Secret key – server only (Settings > API > Project API keys > service_role)
SUPABASE_SECRET_KEY=eyJ...

# Postgres connection string via Session pooler (Settings > Database > Connection pooling > Session mode)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── App ───────────────────────────────────────────────────────────────────────
# Full URL of this environment (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Environment: local | staging | production
NEXT_PUBLIC_APP_ENV=local

# ── Stripe ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
STRIPE_V2_WEBHOOK_SECRET=whsec_...

# ── Internal ─────────────────────────────────────────────────────────────────
# Random secret shared with pg_cron. Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Staging only ─────────────────────────────────────────────────────────────
# Password shown on staging site. Only present in staging environment.
STAGING_PASSWORD=

# ── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@producette.com
# Comma-separated list of allowed recipients outside production
EMAIL_ALLOWLIST=your@email.com

# ── Monitoring ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=

# ── Map ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# ── Dev / testing ────────────────────────────────────────────────────────────
# Multiplies deadlines (hours). 0.0035 → 48 h ≈ 10 min. Must be 1 in production.
DEADLINE_SCALE=1
