{
  "name": "producette",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:rls": "vitest run --config vitest.rls.config.mts",
    "test:e2e": "playwright test",
    "db:types": "supabase gen types typescript --project-ref aeypdriubewywzngjzgf > lib/supabase/database.types.ts",
    "db:new": "supabase migration new",
    "db:reset:dev": "supabase db reset --remote --project-ref aeypdriubewywzngjzgf",
    "seed": "npx tsx scripts/seed.ts",
    "stripe:listen": "stripe listen --all-snapshot --forward-to localhost:3000/api/webhooks/stripe --forward-connect-to localhost:3000/api/webhooks/stripe-connect",
    "stripe:listen:v2": "stripe listen --events \"v2.core.account[requirements].updated,v2.core.account[configuration.recipient].capability_status_updated\" --forward-to localhost:3000/api/webhooks/stripe-v2",
    "sweep": "node scripts/sweep.mjs",
    "sweep:watch": "node scripts/sweep.mjs --watch",
    "prepare": "npx simple-git-hooks",
    "db:pull": "node scripts/drizzle-pull.mjs"
  },
  "simple-git-hooks": {
    "pre-push": "while read l s r v; do case \"$r\" in refs/heads/main) echo 'Push to main blocked — use a feat/* branch and PR.' >&2; exit 1;; esac; done"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@stripe/react-stripe-js": "^7.1.0",
    "@stripe/stripe-js": "^10.4.0",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "@tailwindcss/postcss": "^4.3.5",
    "@vercel/functions": "^3.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.511.0",
    "next": "latest",
    "next-intl": "^4.16.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^23.2.0",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "latest",
    "postcss": "^8",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "simple-git-hooks": "^2.11.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.1"
  }
}
